---
const APP_URL = import.meta.env.PUBLIC_APP_URL || 'https://app.notegod.io';

const cards = [
  {
    name: "Notion",
    tag: "Powerful, but heavy",
    body: "Endless blocks, databases, and a learning curve to match. Great for power users — but it gets complex fast, and team pricing climbs to $10–15 per user.",
    highlight: false,
  },
  {
    name: "Obsidian",
    tag: "Flexible, but technical",
    body: "A tinkerer's dream of local files and plugins. But you assemble it yourself, and the cloud experience costs extra — Sync plus Publish add up to roughly $12 a month.",
    highlight: false,
  },
  {
    name: "NoteGod",
    tag: "Everything you need, simple",
    body: "Rich editor, AES-256 encryption, collaboration, Google Drive, Web Clipper, and offline — all included. No setup, no plugins, no per-feature upsells.",
    highlight: true,
  },
];
---

<section id="comparison" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-16 fade-up">
      <h2 class="display-md uppercase tracking-tight mb-4">
        Everything you need.<br/><span class="text-noter-accent">None of the complexity.</span>
      </h2>
      <p class="text-noter-text-muted text-lg">The all-in-one notes app — without the setup or the price tag.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 fade-up">
      {cards.map((card) => (
        <div class={`rounded-2xl border p-7 flex flex-col ${card.highlight ? 'border-noter-accent/50 bg-noter-accent/[0.04]' : 'border-noter-border bg-noter-surface/30'}`}>
          <h3 class={`text-xl font-bold mb-1 ${card.highlight ? 'text-noter-accent' : 'text-noter-text'}`}>{card.name}</h3>
          <p class="text-xs font-semibold uppercase tracking-wider text-noter-text-muted mb-4">{card.tag}</p>
          <p class="text-noter-text-muted text-sm leading-relaxed">{card.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center fade-up">
      <p class="text-noter-text-muted text-lg max-w-2xl mx-auto">
        All of it — encryption, collaboration, Google Drive, Web Clipper, and offline —
        for <span class="text-noter-accent font-bold">$2.99/mo</span>. No add-ons, no per-feature upsells.
      </p>
      <a href={`${APP_URL}/register`} class="inline-flex items-center mt-7 px-8 py-4 font-semibold text-black rounded-xl text-base transition-all hover:brightness-110 hover:-translate-y-0.5" style="background: linear-gradient(135deg, #edff00, #b8d900);">
        Start Free
      </a>
      <p class="text-noter-text-dim text-sm mt-3 flex items-center justify-center gap-1.5">
        <span class="text-noter-green">&#10003;</span> No credit card required
      </p>
    </div>
  </div>
</section>
